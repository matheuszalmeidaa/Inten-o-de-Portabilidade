# OPCIONAL — você pode preencher tudo direto na seção "CONFIGURAÇÃO — EDITE
# AQUI" no topo do consulta_margem.py, sem precisar deste arquivo.
# O .env só é lido para os campos deixados em branco ("") no script.
#
# Para usar: copie este arquivo para ".env" e preencha com seus dados.
# O .env fica só na sua máquina — NUNCA suba ele para o GitHub.

# Login do Multiplus
MULTIPLUS_USUARIO=SEU_USUARIO_AQUI
MULTIPLUS_SENHA=SUA_SENHA_AQUI
MULTIPLUS_URL=https://multiplus.consignadorapido.com

# Planilha com os CPFs (aba Pagina1 = gid 0, coluna "CPF Cliente")
PLANILHA_URL=https://docs.google.com/spreadsheets/d/1Fln-LwllZyS3SRgBb1psLKmdLRszxoZYV0waD9AyvOM/edit?gid=0#gid=0
COLUNA_CPF=CPF Cliente

# Comportamento do robô
HEADLESS=false            # true = roda sem mostrar a janela do navegador
TIMEOUT_CONSULTA=90       # segundos de espera por consulta
PAUSA_ENTRE_CONSULTAS=1   # pausa (s) entre um CPF e outro
